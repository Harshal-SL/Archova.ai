# ── OpenRouter (LLM Gateway) ──────────────────────────────────────────────────
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Allow paid models (hard-locked to false — only allowed OpenRouter free models used)
ALLOW_PAID_MODELS=false

# Global default model
LLM_MODEL=google/gemini-2.5-flash-lite:free
RAG_GENERATION_MODEL=deepseek/deepseek-r1-0528:free

# Agent-specific OpenRouter Free Model Configuration
INPUT_UNDERSTANDING_MODEL=google/gemini-2.5-flash-lite:free
REQUIREMENT_ENGINEER_MODEL=google/gemini-2.5-flash-lite:free
BUSINESS_ANALYST_MODEL=google/gemini-2.5-flash-lite:free
DOMAIN_EXPERT_MODEL=google/gemini-2.5-flash-lite:free
REQUIREMENT_REVIEW_MODEL=google/gemini-2.5-flash:free
# Phase 2 SAE Planning Agent OpenRouter Free Model Configuration
REQUIREMENT_ANALYSIS_MODEL=google/gemini-2.5-flash:free
TECHNOLOGY_ADVISOR_MODEL=meta-llama/llama-3.3-70b-instruct:free
ARCHITECTURE_PLANNER_MODEL=deepseek/deepseek-r1:free

# Phase 3 SAE HLD Engine OpenRouter Free Model Configuration
HLD_GENERATION_MODEL=meta-llama/llama-3.3-70b-instruct:free
HLD_VALIDATION_MODEL=google/gemini-2.5-flash:free

# Phase 4 SAE Backend LLD Engine OpenRouter Free Model Configuration
BACKEND_LLD_MODEL=meta-llama/llama-3.3-70b-instruct:free
BACKEND_VALIDATION_MODEL=google/gemini-2.5-flash:free

# Phase 5 SAE Database LLD Engine OpenRouter Free Model Configuration
DATABASE_LLD_MODEL=meta-llama/llama-3.3-70b-instruct:free
DATABASE_VALIDATION_MODEL=google/gemini-2.5-flash:free

# Phase 6 SAE Frontend LLD Engine OpenRouter Free Model Configuration
FRONTEND_LLD_MODEL=meta-llama/llama-3.3-70b-instruct:free
FRONTEND_VALIDATION_MODEL=google/gemini-2.5-flash:free

# Phase 7 SAE Security LLD Engine OpenRouter Free Model Configuration
SECURITY_LLD_MODEL=meta-llama/llama-3.3-70b-instruct:free
SECURITY_VALIDATION_MODEL=google/gemini-2.5-flash:free

# Phase 8 SAE Cloud LLD Engine OpenRouter Free Model Configuration
CLOUD_LLD_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUD_VALIDATION_MODEL=google/gemini-2.5-flash:free

# Phase 9 SAE Cross-Architecture Validation & Merge Engine OpenRouter Free Model Configuration
ARCHITECTURE_VALIDATION_MODEL=google/gemini-2.5-flash:free
ARCHITECTURE_MERGE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Phase 10 SAE Incremental Regeneration & Architecture Evolution Engine OpenRouter Free Model Configuration
EVOLUTION_MODEL=meta-llama/llama-3.3-70b-instruct:free
REGENERATION_MODEL=google/gemini-2.5-flash:free
DIFF_MODEL=google/gemini-2.5-flash:free

# Gateway tuning
OPENROUTER_TIMEOUT_SECONDS=120
LLM_GATEWAY_MAX_RETRIES=2
LLM_GATEWAY_JSON_RETRIES=1

# ── Ollama Base URL ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Leave QDRANT_URL pointing at a running server.
# If the server is unreachable the system falls back to local disk storage.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=architecture_rag
# Override local storage path (default: .qdrant_data/ in project root)
# QDRANT_LOCAL_PATH=.qdrant_data

# ── Embeddings ────────────────────────────────────────────────────────────────
RAG_EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RAG_RETRIEVAL_K=10
RAG_SIMILARITY_THRESHOLD=0.3
MMR_LAMBDA=0.7
MAX_CHUNKS_PER_DOCUMENT=1
ENABLE_QUERY_EXPANSION=true
ENABLE_CATEGORY_FILTER=true

# ── Reranking (disabled by default — requires BAAI/bge-reranker-base) ─────────
ENABLE_RERANKING=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=8

# ── Chunking ──────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# ── LLM generation ────────────────────────────────────────────────────────────
RAG_HLD_NUM_PREDICT=1200
RAG_LLD_NUM_PREDICT=1500
RAG_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=240
