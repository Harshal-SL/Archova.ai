# Validator Engine v2 Environment Configuration
# Copy this file to .env and adjust variables as needed

# Service Host and Port
PORT=8002
HOST=0.0.0.0

# Service URLs & CORS
AI_ENGINE_URL=http://localhost:8000
NEXT_APP_ORIGIN=http://localhost:3000

# Reviewer LLM Configuration (OpenAI-compatible / OpenRouter)
# Strict Free-only policy: Verified active OpenRouter free models only.
VALIDATOR_API_BASE=https://openrouter.ai/api/v1
VALIDATOR_API_KEY=your_openrouter_api_key_here
VALIDATOR_MODEL=cohere/north-mini-code:free
VALIDATOR_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,openrouter/free,liquid/lfm-2.5-2.6b:free

# Set to "1" to enable deterministic offline mock mode (no network calls, passes tests)
# Set to "0" to use real live LLM reviewer calls
VALIDATOR_MOCK=0
VALIDATOR_CONCURRENCY=1

# Inbound Security (Optional: skip or leave empty during local development)
VALIDATOR_API_KEY_INBOUND=

# Calibration Thresholds & Pipeline Limits
ACCEPT_THRESHOLD=80
MAX_ROUNDS=2
LLM_TIMEOUT_SECONDS=60.0
ITERATION_TIMEOUT_SECONDS=180.0
TOTAL_PIPELINE_TIMEOUT_SECONDS=600.0
